# 편집(입력/수정) 시 입력하는 비밀번호. 설정하지 않으면 기본값(1234)이 쓰이므로,
# 배포 환경에서는 반드시 별도 값으로 설정하세요.
EDIT_PASSWORD=1234

# Supabase — 실제 데이터(팀/공정/설비/생산실적) 저장소.
# URL은 브라우저에도 노출돼도 되지만(NEXT_PUBLIC_), SECRET_KEY는 서버(API 라우트)에서만
# 쓰며 RLS를 우회하므로 절대 브라우저 코드나 NEXT_PUBLIC_ 변수로 만들지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Microsoft 365(Azure AD) 로그인 — 구현은 돼 있으나 지금은 사용하지 않습니다 (CLAUDE.md 8번 참고).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
